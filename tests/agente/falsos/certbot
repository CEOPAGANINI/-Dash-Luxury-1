#!/usr/bin/env python3
"""certbot FALSO: registra o argv e, no certonly, cria um certificado REAL com o openssl.

O teste lê a validade com o openssl de verdade, então o ajudante é exercitado de ponta a ponta.
Falha forçada: $RAIZ/falhas/certbot (o conteúdo vira a saída de erro, como a do Let's Encrypt).
Validade em dias: $RAIZ/certbot-dias (padrão 90). Qualquer "hook" no argv é erro fatal.
"""
import os
import re
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True  # os falsos rodam com ambiente fixo: nada de __pycache__ no repositório
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _comum import falha, raiz, registrar  # noqa: E402


def valor(args, opcao):
    return args[args.index(opcao) + 1] if opcao in args else None


def certonly(args):
    if any("hook" in a for a in args):
        print("certbot falso: hook no argv é proibido", file=sys.stderr)
        return 3
    webroot, nome = valor(args, "-w"), valor(args, "--cert-name")
    dominios = [args[i + 1] for i, a in enumerate(args) if a == "-d"]
    if not webroot or not os.path.isdir(webroot) or not nome or not re.match(r"^dash-[a-z0-9-]+$", nome) or not dominios:
        print("certbot falso: argumentos incompletos", file=sys.stderr)
        return 2
    erro = falha("certbot")
    if erro is not None:
        print(erro, file=sys.stderr)
        return 1
    live = os.path.join(raiz(), "etc/letsencrypt/live", nome)
    os.makedirs(live, exist_ok=True)
    try:
        with open(os.path.join(raiz(), "certbot-dias"), encoding="utf-8") as f:
            dias = f.read().strip()
    except FileNotFoundError:
        dias = "90"
    san = ",".join("DNS:" + d for d in dominios)
    subprocess.run(
        ["openssl", "req", "-x509", "-newkey", "ec", "-pkeyopt", "ec_paramgen_curve:prime256v1", "-nodes",
         "-keyout", os.path.join(live, "privkey.pem"), "-out", os.path.join(live, "cert.pem"),
         "-days", dias, "-subj", "/CN=" + dominios[0], "-addext", "subjectAltName=" + san],
        check=True, capture_output=True,
    )
    shutil.copyfile(os.path.join(live, "cert.pem"), os.path.join(live, "chain.pem"))
    with open(os.path.join(live, "fullchain.pem"), "w", encoding="utf-8") as f:
        f.write(open(os.path.join(live, "cert.pem"), encoding="utf-8").read())
    renewal = os.path.join(raiz(), "etc/letsencrypt/renewal")
    os.makedirs(renewal, exist_ok=True)
    with open(os.path.join(renewal, nome + ".conf"), "w", encoding="utf-8") as f:
        f.write(f"# certbot falso\nwebroot_path = {webroot}\n")
    print(f"Successfully received certificate.\nCertificate is saved at: /etc/letsencrypt/live/{nome}/fullchain.pem")
    return 0


def delete(args):
    nome = valor(args, "--cert-name")
    base = os.path.join(raiz(), "etc/letsencrypt")
    alvos = [os.path.join(base, "live", nome), os.path.join(base, "archive", nome), os.path.join(base, "renewal", nome + ".conf")]
    if not any(os.path.lexists(a) for a in alvos):
        print(f"No certificate found with name {nome}", file=sys.stderr)
        return 1
    for a in alvos:
        if os.path.isdir(a):
            shutil.rmtree(a)
        elif os.path.lexists(a):
            os.unlink(a)
    print(f"Deleted all files relating to certificate {nome}.")
    return 0


def main():
    registrar("certbot")
    args = sys.argv[1:]
    if args[:1] == ["--version"]:
        print("certbot 2.9.0")
        return 0
    if args[:1] == ["certonly"]:
        return certonly(args[1:])
    if args[:1] == ["delete"]:
        return delete(args[1:])
    return 0


if __name__ == "__main__":
    sys.exit(main())
