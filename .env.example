# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (servidor — nunca expor no navegador)
SUPABASE_SERVICE_ROLE_KEY=

# Banco de dados
DATABASE_URL=
DIRECT_URL=

# Segurança
ENCRYPTION_KEY=

# Servidor do Funil (VPS) — ver docs/VPS.md
# Quem opera: lista separada por vírgula. Item com "@" = e-mail (só vale
# confirmado); item sem "@" = id da conta. Vazia: ninguém opera.
VPS_DONOS=
# 32 caracteres ou mais (openssl rand -base64 48). Deriva as chaves de cada
# servidor; trocar depois obriga todo agente a reconectar.
VPS_CHAVE_MESTRA=
# Opcional: origens https extras que podem receber o /checkout dos sites.
VPS_CHECKOUT_ORIGENS=
# Opcional: publicar, trocar domínio ou checkout e remover exigem login
# feito nas últimas N horas (padrão 12; até 720).
VPS_LOGIN_RECENTE_HORAS=

# E-mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Pagamentos
BROSKI_API_KEY=
BROSKI_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
PAGARME_API_KEY=
ASAAS_API_KEY=

# Integrações
UPSTASH_REDIS_REST_URL=
UTMIFY_API_TOKEN=

# OAuth das redes de anúncio (Integrações → Conectar com Meta / Google)
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: lista as contas do Google Ads na autorização
GOOGLE_ADS_DEVELOPER_TOKEN=
